# =============================================================================
# Variables de entorno de la web de DOFI
#
# Copia este archivo a ".env.local" para desarrollo (esta en .gitignore, no
# se sube) y define los mismos nombres en Cloudflare para produccion:
#   pagina-dofi -> Settings -> Variables and Secrets
#
# NUNCA pongas valores reales en este archivo.
#
# Todas son OPCIONALES: el sitio arranca sin ninguna. Lo que cambia es que
# sin ellas se comporta como staging y el formulario no puede entregar leads.
# =============================================================================


# --- Dominio publico ---------------------------------------------------------
# Dominio definitivo del sitio, con protocolo y sin barra final.
#   ej.  https://dofi.agency
#
# Es la unica variable que decide si el sitio es indexable:
#   - vacia, o un host *.workers.dev / localhost  -> STAGING
#       robots.txt: Disallow /  ·  <meta robots> noindex,nofollow  ·  sin canonical
#   - un dominio propio                           -> PRODUCCION
#       robots.txt abierto  ·  canonical absoluto  ·  sitemap declarado
#
# Consumida por src/config/site.ts.
NEXT_PUBLIC_SITE_URL=


# --- Entrega de leads del formulario -----------------------------------------
# Endpoint que RECIBE el lead del formulario de contacto: un webhook de n8n,
# un escenario de Make, una funcion propia que cree el lead en Kommo, etc.
# Recibe un POST con JSON:
#   { id, nombre, email, empresa?, telefono?, mensaje, source, utm, submittedAt }
#
# SIN esta variable, /api/contacto responde 503 y el formulario le dice al
# usuario que no se pudo enviar y le ofrece WhatsApp. Nunca finge exito.
CONTACT_WEBHOOK_URL=

# Opcional. Si se define, se envia como "Authorization: Bearer <token>".
# Dejala vacia si el webhook no exige autenticacion.
CONTACT_WEBHOOK_TOKEN=


# --- Datos corporativos ------------------------------------------------------
# Solo hace falta definirlos para SOBREESCRIBIR lo que ya trae
# src/config/company.ts. Los valores por defecto del codigo son los reales.

# Numero de WhatsApp, solo digitos, sin "+" ni espacios.  ej. 593984472869
NEXT_PUBLIC_COMPANY_WHATSAPP=

# Telefono tal como se muestra en pantalla.  ej. +593 98 447 2869
NEXT_PUBLIC_COMPANY_PHONE=

# Correo de contacto. Definelo cuando exista el correo corporativo propio
# (hoy el sitio usa una cuenta de Gmail).
NEXT_PUBLIC_COMPANY_EMAIL=

# Direccion de calle. Si queda vacia, no se muestra ninguna direccion.
NEXT_PUBLIC_COMPANY_ADDRESS=


# --- Redes sociales ----------------------------------------------------------
# URL COMPLETA del perfil real de DOFI en cada plataforma.
#   ej.  https://www.instagram.com/tu-usuario
#
# Pie de pagina (Footer.tsx, src/config/company.ts -> socialLinks): el icono
# se muestra SOLO si su variable tiene una URL. Vacia = icono oculto. Es a
# proposito: antes los tres enlazaban a instagram.com, tiktok.com y
# linkedin.com (las portadas de las plataformas), y eso resta credibilidad.
# Mejor no mostrar el icono que mandar al sitio equivocado.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Header (Nav.tsx, src/config/company.ts -> headerSocialLinks): a diferencia
# del pie, el bloque social del Header SIEMPRE se pinta visible (Facebook +
# Instagram + TikTok) por pedido explicito -- sin esta variable, ese icono
# se ve igual mente pero no navega a ningun lado (no finge una URL). Define
# NEXT_PUBLIC_FACEBOOK_URL para activarlo; Instagram/TikTok reutilizan las
# mismas variables de arriba.
NEXT_PUBLIC_FACEBOOK_URL=


# --- Sanity (CMS) ------------------------------------------------------------
# Alimentan las Cuentas (carrusel, muro de logos, pagina individual, sitemap)
# y los textos de Hacemos / El Socio / Cierre. Ver src/lib/sanity.ts y el
# Studio en studio/ (proyecto Sanity independiente, no forma parte de este
# build).
#
# ESTADO ACTUAL: no estan definidas en el Worker, asi que produccion sirve el
# contenido de respaldo escrito en el codigo (src/data/clients.ts). Definelas
# con el projectId/dataset reales para activarlo.
#
# Se leen server-side (sin prefijo NEXT_PUBLIC_): el fetch nunca llega al
# navegador.
SANITY_PROJECT_ID=
SANITY_DATASET=

# Secreto compartido para /api/revalidate: Sanity lo llama por webhook al
# publicar una cuenta/contenido/servicio, asi la web se actualiza sola sin
# esperar el ISR de 60s ni hacer un redeploy manual. Configuralo tambien en
# manage.sanity.io -> tu proyecto -> API -> Webhooks.
SANITY_REVALIDATE_SECRET=

# Solo hace falta en tu maquina, para correr `npm run seed:sanity` UNA vez
# (migra las cuentas de src/data/clients.ts a Sanity). Token de escritura
# creado en manage.sanity.io -> API -> Tokens. NUNCA lo cargues en Cloudflare.
SANITY_WRITE_TOKEN=
